<style>
  :root { --ink:#1d2433; --muted:#5b6475; --line:#dfe3ea; --bg:#f6f7f9; --card:#fff;
          --pass:#1f7a4d; --pass-bg:#e5f4ec; --fail:#b42318; --fail-bg:#fdecea;
          --skip:#8a5a00; --skip-bg:#fdf3dc; --info:#3b5bdb; --info-bg:#edf1fd; }
  * { box-sizing: border-box; }
  body { margin:0; font: 14px/1.55 -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
         color: var(--ink); background: var(--bg); }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 28px 24px 60px; }
  header.top { display:flex; justify-content:space-between; align-items:flex-start; gap:16px;
               border-bottom: 2px solid var(--ink); padding-bottom: 14px; margin-bottom: 20px; }
  h1 { font-size: 20px; margin: 0 0 4px; font-weight: 600; }
  h2 { font-size: 15px; margin: 28px 0 10px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .sub { color: var(--muted); font-size: 13px; word-break: break-all; }
  .badge { display:inline-block; padding: 3px 10px; border-radius: 4px; font-weight: 600; font-size: 12px;
           text-transform: uppercase; letter-spacing: .04em; }
  .passed { color: var(--pass); background: var(--pass-bg); }
  .failed, .error { color: var(--fail); background: var(--fail-bg); }
  .skipped { color: var(--skip); background: var(--skip-bg); }
  .info { color: var(--info); background: var(--info-bg); }
  .fallback { color: #8a5a00; background: #fbecc7; }
  .fixbanner { border: 2px solid #b8891f; background: #fbf1d6; color: #5c3d00; padding: 12px 14px; margin: 18px 0; }
  .grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1px;
          background: var(--line); border:1px solid var(--line); border-radius: 6px; overflow:hidden; }
  .grid div { background: var(--card); padding: 9px 12px; }
  .grid b { display:block; font-size: 11px; text-transform: uppercase; letter-spacing:.05em; color: var(--muted); font-weight:600; }
  table { width:100%; border-collapse: collapse; background: var(--card); border:1px solid var(--line); }
  th, td { text-align:left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { background: #eef0f4; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  td.num { width: 42px; color: var(--muted); }
  td.shot img { width: 180px; border: 1px solid var(--line); border-radius: 3px; display:block; }
  .err { background: var(--fail-bg); color: var(--fail); border-left: 4px solid var(--fail); padding: 12px 14px;
         white-space: pre-wrap; font-family: ui-monospace, Consolas, monospace; font-size: 12px; overflow-x:auto; }
  pre.data { background: var(--card); border:1px solid var(--line); padding: 12px; font-size: 12px; overflow-x:auto; }
  .muted { color: var(--muted); }
  .mono { font-family: ui-monospace, Consolas, monospace; font-size: 12px; }
  a { color: #2348a8; }
  footer { margin-top: 36px; color: var(--muted); font-size: 12px; border-top: 1px solid var(--line); padding-top: 12px; }
  @media print { body { background:#fff; } .wrap { padding: 0; } td.shot img { width: 140px; }
                 table, .grid { page-break-inside: auto; } tr { page-break-inside: avoid; } }
</style>
