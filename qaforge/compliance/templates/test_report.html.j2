<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Evidence - {{ r.test_name }}</title>
{% include "_style.html.j2" %}
</head><body><div class="wrap">

<header class="top">
  <div>
    <h1>{{ r.test_name }}</h1>
    <div class="sub mono">{{ r.nodeid }}</div>
  </div>
  <span class="badge {{ r.outcome }}">{{ r.outcome }}</span>
</header>

<div class="grid">
  <div><b>JIRA</b>{{ r.jira_keys | join(", ") or "not linked" }}</div>
  <div><b>Environment</b>{{ r.env | upper }}</div>
  <div><b>Run ID</b><span class="mono">{{ r.run_id }}</span></div>
  <div><b>Duration</b>{{ r.duration_s }} s</div>
  <div><b>Started (UTC)</b>{{ r.started_at }}</div>
  <div><b>Finished (UTC)</b>{{ r.finished_at }}</div>
  <div><b>Executed by</b>{{ r.run.triggered_by }} @ {{ r.run.host }}</div>
  <div><b>Build / commit</b>{{ r.run.ci_build or "local run" }} / {{ r.run.git_commit or "n/a" }}</div>
  <div><b>Browser</b>{{ r.run.browser or "-" }} {{ r.run.browser_version or "" }}</div>
  <div><b>Framework</b>qaforge {{ r.run.framework_version }} · Playwright {{ r.run.playwright_version }} · Python {{ r.run.python_version }}</div>
  <div><b>Markers</b>{{ r.markers | join(", ") or "-" }}</div>
</div>

{% if r.locator_fallbacks %}
<div class="fixbanner"><b>LOCATOR FALLBACK USED - locator fix needed.</b> The test continued with a backup locator
{{ r.locator_fallbacks|length }} time(s). Nothing was hidden; update the page object so the primary locator works again.
<table style="margin-top:8px"><tr><th>Element</th><th>Primary (failed)</th><th>Found</th><th>Fallback used</th></tr>
{% for f in r.locator_fallbacks %}<tr><td class="mono">{{ f.element }}</td><td class="mono">{{ f.primary }}</td><td>{{ f.primary_count }}</td><td class="mono">{{ f.used }}</td></tr>{% endfor %}
</table></div>
{% endif %}

{% if r.error %}
<h2>Failure</h2>
<div class="err">{{ r.error }}</div>
{% endif %}

<h2>Execution steps ({{ r.steps | length }})</h2>
<table>
  <tr><th>#</th><th>Step</th><th>Status</th><th>App</th><th>Time (UTC)</th><th>ms</th><th>Screenshot</th></tr>
  {% for s in r.steps %}
  <tr>
    <td class="num">{{ s.index }}</td>
    <td>{{ s.name }}{% if s.detail %}<div class="muted mono">{{ s.detail }}</div>{% endif %}
        {% if s.error %}<div class="err">{{ s.error }}</div>{% endif %}</td>
    <td><span class="badge {{ s.status }}">{{ s.status }}</span></td>
    <td>{{ s.app or "" }}</td>
    <td class="mono">{{ s.started_at[11:23] }}</td>
    <td class="mono">{{ s.duration_ms }}</td>
    <td class="shot">{% if s.screenshot %}<a href="{{ s.screenshot }}" target="_blank"><img src="{{ s.screenshot }}" alt="step {{ s.index }}"></a>{% endif %}</td>
  </tr>
  {% endfor %}
</table>

{% if r.verifications %}
<h2>Data verifications ({{ r.verifications | length }})</h2>
{% for v in r.verifications %}
<p><span class="badge {{ 'passed' if v.passed else 'failed' }}">{{ 'match' if v.passed else 'mismatch' }}</span>
   <b>{{ v.name }}</b> <span class="muted">source: {{ v.source }} · {{ v.started_at }}</span></p>
<table>
  <tr><th>Field</th><th>Expected (entered)</th><th>Actual (observed)</th><th>Rule</th><th>Result</th></tr>
  {% for row in v.rows %}
  <tr><td class="mono">{{ row.field }}</td><td class="mono">{{ row.expected }}</td><td class="mono">{{ row.actual }}</td>
      <td>{{ row.rule }}</td><td><span class="badge {{ 'passed' if row.match else 'failed' }}">{{ 'ok' if row.match else 'diff' }}</span></td></tr>
  {% endfor %}
</table>
{% endfor %}
{% endif %}

<h2>Test data used (masked)</h2>
<pre class="data">{{ r.data_used | tojson(indent=2) }}</pre>

<h2>Attachments</h2>
<table>
  <tr><th>Type</th><th>File</th></tr>
  {% for a in r.attachments %}<tr><td>{{ a.kind }}</td><td><a href="{{ a.file }}">{{ a.file }}</a></td></tr>{% endfor %}
  <tr><td>log</td><td><a href="test.log.jsonl">test.log.jsonl</a></td></tr>
  <tr><td>integrity</td><td><a href="manifest.json">manifest.json</a> (SHA-256 of every file)</td></tr>
</table>

<footer>Generated by qaforge {{ r.run.framework_version }}. Sensitive values are masked in text and screenshots.
Integrity can be checked with <span class="mono">qaforge verify-evidence &lt;folder|zip&gt;</span>.</footer>
</div></body></html>
